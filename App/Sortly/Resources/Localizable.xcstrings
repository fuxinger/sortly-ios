        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlock"
          }
        }
      }
    },
    "Freischalten für %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlock for %@"
          }
        }
      }
    },
    "Für diesen Bereich gibt es gerade nichts zu tun." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There’s nothing to do in this area right now."
          }
        }
      }
    },
    "Geschichte über" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Story about"
          }
        }
      }
    },
    "Geschrieben von Apple Intelligence auf deinem iPhone, nur aus Zahlen, Orten und Themen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Written by Apple Intelligence on your iPhone, using only numbers, places and topics."
          }
        }
      }
    },
    "Gezählt werden deine Hauptbereiche: %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Counted are your main areas: %@."
          }
        }
      }
    },
    "Gib diesem Ort oder dieser Gruppe einen Namen. SORTLY benennt persönliche Orte nie selbst." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give this place or group a name. SORTLY never names personal places on its own."
          }
        }
      }
    },
    "Gleicher Name, anderer Inhalt" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Same name, different content"
          }
        }
      }
    },
    "Gruppen werden gebildet" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forming groups"
          }
        }
      }
    },
    "Hauptbereiche" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Main areas"
          }
        }
      }
    },
    "Hauptordner" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Main folder"
          }
        }
      }
    },
    "Haustiere und – nur wenn du es einschaltest – Gesichter." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pets and, only if you turn it on, faces."
          }
        }
      }
    },
    "Hinweis" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note"
          }
        }
      }
    },
    "Häufige Orte" : {

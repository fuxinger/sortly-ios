          }
        }
      }
    },
    "Foto in mehreren Alben erlauben" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow a photo in several albums"
          }
        }
      }
    },
    "Foto vom Lieblingsziel zeigen" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show photo of favorite destination"
          }
        }
      }
    },
    "Fotos sortiert" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos sorted"
          }
        }
      }
    },
    "Fotos werden nur in Alben einsortiert. Die Originale bleiben, wo sie sind, und jede Änderung lässt sich rückgängig machen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos are only added to albums. The originals stay where they are, and every change can be undone."
          }
        }
      }
    },
    "Fotos, die du ignorierst, tauchen hier auf und werden nicht mehr vorgeschlagen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos you ignore show up here and are no longer suggested."
          }
        }
      }
    },
    "Freigeschaltet" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlocked"
          }
        }
      }
    },
    "Freischalten" : {

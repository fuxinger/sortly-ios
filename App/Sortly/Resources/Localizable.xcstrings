          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignore"
          }
        }
      }
    },
    "Ignoriert" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignored"
          }
        }
      }
    },
    "Ignorierte Fotos schlägt SORTLY nicht mehr vor. Am Foto selbst ändert sich nichts." : {
      "localizations" : {

    },
    "Erkennt Reisen und Ausflüge und trennt sie vom Alltag zu Hause." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recognizes trips and outings and separates them from everyday life at home."

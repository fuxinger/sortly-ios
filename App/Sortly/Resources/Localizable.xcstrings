    },
    "Offene Vorschläge" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open suggestions"
          }
        }
      }
    },
    "Sagt dir, wie viele Albumvorschläge auf dich warten, und gibt sie an Kurzbefehle weiter." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tells you how many album suggestions are waiting and passes them on to Shortcuts."
          }
        }
      }
    },
    "Vorschlag öffnen" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open suggestion"
          }

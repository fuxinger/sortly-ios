    "Es gibt noch kein passendes Album." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is no matching album yet."
          }
        }
      }
    },
    "Es gibt schon ein Album „%@“, aber mit anderem Inhalt (%lld gemeinsame Aufnahmen)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is already an album “%1$@”, but with different content (%2$lld shared items)."
